<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level2" level="2" version="1">
  <model id="fibroblast">
    <listOfCompartments>
      <compartment id="default" size="1"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="Clot" name="Clot" compartment="default" initialAmount="0" charge="0"/>
      <species id="Collagen" name="Collagen" compartment="default" initialAmount="0" charge="0"/>
      <species id="PDGF" name="PDGF" compartment="default" initialAmount="0" charge="0"/>
      <species id="IL1" name="IL1" compartment="default" initialAmount="0" charge="0"/>
      <species id="TGFa" name="TGFa" compartment="default" initialAmount="0" charge="0"/>
      <species id="EGF" name="EGF" compartment="default" initialAmount="0" charge="0"/>
      <species id="TGFb1" name="TGFb1" compartment="default" initialAmount="0" charge="0"/>
      <species id="TGFb3" name="TGFb3" compartment="default" initialAmount="0" charge="0"/>
      <species id="FGF2" name="FGF2" compartment="default" initialAmount="0" charge="0"/>
      <species id="MMP" name="MMP" compartment="default" initialAmount="0" charge="0"/>
      <species id="TNFa" name="TNFa" compartment="default" initialAmount="0" charge="0"/>
      <species id="KGF" name="KGF" compartment="default" initialAmount="0" charge="0"/>
      <species id="Procollagen" name="Procollagen" compartment="default" initialAmount="0" charge="0"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="ks_clot" value="0"/>
      <parameter id="ks_collagen" value="0"/>
      <parameter id="ks_pdgf" value="0"/>
      <parameter id="ks_il1" value="0"/>
      <parameter id="ks_tgfa" value="0"/>
      <parameter id="ks_egf" value="0"/>
      <parameter id="ks_tgfb1" value="0"/>
      <parameter id="ks_tgfb3" value="0"/>
      <parameter id="ks_fgf2" value="0"/>
      <parameter id="ks_mmp" value="0"/>
      <parameter id="ks_tnfa" value="0"/>
      <parameter id="ks_kgf" value="0"/>

      <parameter id="kpc_proc_coll" value="0.1"/>

      <parameter id="kd_clot" value="0"/>
      <parameter id="kd_collagen" value="0" constant="false"/>
      <parameter id="kd0_collagen" value="1.0E-9"/>
      <parameter id="kd1_collagen_mmp" value="1.0E-4"/>
      <parameter id="kd_pdgf" value="1.668e-3" unit="min^-1"/>
      <notes> Menon et al. 2012.  </notes>
      <parameter id="kd_il1" value="1.152E-2" unit="min^-1"/>
      <notes> Menon et al. 2012.  </notes>
      <parameter id="kd_tgfa" value="1.0E-3"/>
      <parameter id="kd_egf" value="1.0E-3"/>
      <parameter id="kd_tgfb1" value="2.458E-4" unit="min^-1"/>
      <parameter id="kd_tgfb3" value="2.458E-4" unit="min^-1"/>
      <notes> Menon et al. 2012.  </notes>
      <parameter id="kd_fgf2" value="1.0E-3"/>
      <parameter id="kd_mmp" value="1.0E-3"/>
      <parameter id="kd_tnfa" value="1.0E-3"/>
      <parameter id="kd_kgf" value="1.0E-3"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="kd_collagen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> kd0_collagen </ci>
            <apply>
              <plus/>
              <cn> 1 </cn>
              <apply>
                <times/>
                <ci> kd1_collagen_mmp </ci>
                <ci> MMP </ci>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="SynCol1" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Procollagen"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Collagen"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kpc_proc_coll </ci>
              <ci> Procollagen </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegClot" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Clot"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_clot </ci>
              <ci> Clot </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegCol" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Collagen"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_collagen </ci>
              <ci> Collagen </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegPDGF" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="PDGF"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_pdgf </ci>
              <ci> PDGF </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegIL1" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="IL1"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_il1 </ci>
              <ci> IL1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegTGFa" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="TGFa"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_tgfa </ci>
              <ci> TGFa </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegEGF" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="EGF"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_egf </ci>
              <ci> EGF </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegTGFb1" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="TGFb1"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_tgfb1 </ci>
              <ci> TGFb1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegTGFb3" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="TGFb3"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_tgfb3 </ci>
              <ci> TGFb3 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegFGF2" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="FGF2"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_fgf2 </ci>
              <ci> FGF2 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegMMP" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="MMP"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_mmp </ci>
              <ci> MMP </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegTNFa" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="TNFa"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_tnfa </ci>
              <ci> TNFa </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegKGF" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="KGF"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> kd_kgf </ci>
              <ci> KGF </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
