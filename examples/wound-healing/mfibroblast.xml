<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level2" level="2" version="1">
  <model id="fibroblast">
    <listOfCompartments>
      <compartment id="default" size="1"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="WoundSignal" name="WoundSignal" compartment="default" initialAmount="0" charge="0"/>
      <species id="Clot" name="Clot" compartment="default" initialAmount="0" charge="0"/>
      <species id="Collagen" name="Collagen" compartment="default" initialAmount="0" charge="0"/>
      <species id="PDGF" name="PDGF" compartment="default" initialAmount="0" charge="0"/>
      <species id="KGF" name="KGF" compartment="default" initialAmount="0" charge="0"/>
      <species id="IL1" name="IL1" compartment="default" initialAmount="0" charge="0"/>
      <species id="TGFb1" name="TGFb1" compartment="default" initialAmount="0" charge="0"/>
      <species id="Procollagen" name="Procollagen" compartment="default" initialAmount="0" charge="0"/>
      <species id="MMP" name="MMP" compartment="default" initialAmount="0" charge="0"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="KS_PROCOLLAGEN" value="0" constant="false"/>
      <parameter id="KSMAX_PROCOL" value="3"/>
      <parameter id="N_PROCOL" value="1"/>
      <parameter id="KD_TGFb1_PROCOL" value="100" unit="nM"/>

      <parameter id="KS_KGF" value="0" constant="false"/>
      <parameter id="KSMAX_KGF" value="8" unit="/s"/>
      <parameter id="N_KGF" value="1"/>
      <parameter id="KD_PDGF_KGF" value="50" unit="nM"/>
      
      <parameter id="KS_TGFb1" value="0" constant="false"/>
      <parameter id="KSMAX_TGFb1" value="100" unit="/s"/>
      <parameter id="N_TGFb1" value="1"/>
      <parameter id="KD_PDGF_TGFb1" value="50" unit="nM"/>
      <parameter id="KD_IL1_TGFb1" value="50" unit="nM"/>
      
      <parameter id="KD_PDGF" value="1.668e-2" unit="min^-1"/>
      <notes> Haugh et al. BJ 2006; Menon et al. 2012.  </notes>
      <parameter id="KD_IL1" value="1.0E-2"/>
      <parameter id="KD_TGFb1" value="2.458E-4" unit="min^-1"/>
      <notes> Menon et al. 2012.  </notes>

      <parameter id="Prob_DoNothing" value="1.0" />
      <parameter id="Prob_GrowthDiv" value="0.0" constant="false"/>
      <parameter id="Prob_Migration" value="0.0" constant="false"/>
      <parameter id="Prob_Apoptosis" value="0.001" />

      <parameter id="n_GrowthDiv" value="2"/>
      <parameter id="Pmax_GrowthDiv" value="0.05"/>
      <parameter id="KD_PDGF_GD" value="100" unit="nM"/>

      <parameter id="n_Migration" value="3"/>
      <parameter id="Pmax_Migration" value="1.0"/>
      <parameter id="KD_PDGF_MG" value="10000" unit="nM"/>

    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="Prob_GrowthDiv">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <cn> 0.01 </cn>
          <apply>
            <times/>
            <ci> Pmax_GrowthDiv </ci>
            <apply>
              <divide/>
              <apply>
                  <power/>
                  <ci> PDGF </ci>
                  <ci> n_GrowthDiv </ci>
              </apply>
              <apply>
                  <plus/>
                  <ci> KD_PDGF_GD </ci>
                  <apply>
                    <power/>
                    <ci> PDGF </ci>
                    <ci> n_GrowthDiv </ci>
                  </apply>
              </apply>
            </apply>
          </apply>
        </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Prob_Migration">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <cn> 0.01 </cn>
          <apply>
            <times/>
            <ci> Pmax_Migration </ci>
            <apply>
              <divide/>
              <apply>
                  <power/>
                  <ci> PDGF </ci>
                  <ci> n_Migration </ci>
              </apply>
              <apply>
                <plus/>
                <ci> KD_PDGF_MG </ci>
                <apply>
                  <power/>
                  <ci> PDGF </ci>
                  <ci> n_Migration </ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="KS_PROCOLLAGEN">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> KSMAX_PROCOL </ci>
            <apply>
              <divide/>
              <apply>
                  <power/>
                  <ci> TGFb1 </ci>
                  <ci> N_PROCOL </ci>
              </apply>
              <apply>
                  <plus/>
                  <ci> KD_TGFb1_PROCOL </ci>
                  <apply>
                    <power/>
                    <ci> TGFb1 </ci>
                    <ci> N_PROCOL </ci>
                  </apply>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="KS_TGFb1">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> KSMAX_TGFb1 </ci>
            <apply>
              <divide/>
              <apply>
                  <power/>
                  <ci> PDGF </ci>
                  <ci> N_TGFb1 </ci>
              </apply>
              <apply>
                <times/>
                <apply>
                  <plus/>
                  <ci> KD_PDGF_TGFb1 </ci>
                  <apply>
                    <power/>
                    <ci> PDGF </ci>
                    <ci> N_TGFb1 </ci>
                  </apply>
                </apply>
                <apply>
                  <plus/>
                  <ci> KD_IL1_TGFb1 </ci>
                  <apply>
                    <power/>
                    <ci> IL1 </ci>
                    <ci> N_TGFb1 </ci>
                  </apply>
                </apply>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="KS_KGF">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> KSMAX_KGF </ci>
            <apply>
              <divide/>
              <apply>
                  <power/>
                  <ci> PDGF </ci>
                  <ci> N_KGF </ci>
              </apply>
              <apply>
                  <plus/>
                  <ci> KD_PDGF_KGF </ci>
                  <apply>
                    <power/>
                    <ci> PDGF </ci>
                    <ci> N_KGF </ci>
                  </apply>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>

    <listOfReactions>
      <reaction id="SynCol" reversible="false" fast="false">
        <listOfProducts>
          <speciesReference species="Procollagen"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KS_PROCOLLAGEN </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="SynTGFb1" reversible="false" fast="false">
        <listOfProducts>
          <speciesReference species="TGFb1"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KS_TGFb1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="SynKGF" reversible="false" fast="false">
        <listOfProducts>
          <speciesReference species="KGF"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KS_KGF </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>

      <reaction id="DegPDGF" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="PDGF"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KD_PDGF </ci>
              <ci> PDGF </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegIL1" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="IL1"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KD_IL1 </ci>
              <ci> IL1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="DegTGFb1" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="TGFb1"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> default </ci>
              <ci> KD_TGFb1 </ci>
              <ci> TGFb1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
